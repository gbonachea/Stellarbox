prefix=@CMAKE_INSTALL_PREFIX@
exec_prefix=${prefix}
libdir=${exec_prefix}/@CMAKE_INSTALL_LIBDIR@
includedir=${prefix}/@CMAKE_INSTALL_INCLUDEDIR@

Name: Obt
Description: Stellarbox Toolkit Library
Version: @OBT_VERSION@
Requires: glib-2.0 libxml-2.0 x11 xext xrandr xrender
Libs: -L${libdir} -lobt
Cflags: -I${includedir}/openbox